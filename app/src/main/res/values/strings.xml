    <string name="help_title">Controls</string>
    <string name="help_text">D-pad / left stick: move the highlight\nOK / A: select\nBack / B: go back, close a dialog, or hide the keyboard\nHold Back, Menu or Start: settings\n\nY / Search: search for a movie or show\nX: go to Discover\nLB / RB, Rewind / Fast-forward, Channel +/-: page up / down\nRight stick: scroll\nView / Select: reload\n\nTo request something: highlight a poster, press OK, then choose Request.</string>
